# ============================================
# PROJECT BOOTSTRAPPER — ENVIRONMENT CONFIG
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bantuin_dev?schema=public"

# Auth Secret (Auth.js v5 / JWT signing)
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# Note: AI Provider API keys ARE NOT stored here.
# They are supplied per session via the BYOK UI and NEVER persisted.
